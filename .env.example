# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_USER=social
POSTGRES_PASSWORD=social_dev_password
POSTGRES_DB=social
DATABASE_URL=postgresql://social:social_dev_password@postgres:5436/social

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- URLs ---
FRONTEND_URL=http://localhost:3002
BACKEND_URL=http://localhost:4000
PUBLIC_BACKEND_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3002

# --- Auth (Phase 2) ---
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret used by the frontend (NextAuth) to call the backend
# server-to-server when syncing users on first login.
INTERNAL_API_TOKEN=replace_with_a_long_random_string

# --- Backend ---
PORT=4000
NODE_ENV=development

# --- Google Analytics ---
NEXT_PUBLIC_GTAG_ID=G-45TBY74P9E
