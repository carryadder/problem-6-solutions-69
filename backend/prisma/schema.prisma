// Prisma schema — full model for Phases 2-6.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  googleId       String   @unique
  email          String   @unique
  displayName    String
  handle         String   @unique
  bio            String?  @db.VarChar(160)
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  setupComplete  Boolean  @default(false)
  pushLikeEnabled    Boolean @default(true)
  pushCommentEnabled Boolean @default(true)
  pushReplyEnabled   Boolean @default(true)
  pushMentionEnabled Boolean @default(true)
  pushMessageEnabled Boolean @default(true)
  quietHoursEnabled Boolean @default(false)
  quietHoursStartMinutes Int @default(1320)
  quietHoursEndMinutes Int @default(480)
  quietHoursTimeZone String @default("UTC")

  posts                Post[]
  comments             Comment[]
  likes                Like[]
  shares               Share[]
  notifications        Notification[]      @relation("NotificationRecipient")
  notificationsCreated Notification[]      @relation("NotificationActor")
  conversationMembers  ConversationMember[]
  messages             Message[]
  messageReactions     MessageReaction[]
  pushSubscriptions    PushSubscription[]
  blocksInitiated      UserBlock[]         @relation("UserBlocksInitiated")
  blocksReceived       UserBlock[]         @relation("UserBlocksReceived")
  reportsFiled         UserReport[]        @relation("UserReportsFiled")
  reportsReceived      UserReport[]        @relation("UserReportsReceived")

  @@index([handle])
  @@index([email])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.VarChar(2000)
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  shares   Share[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model Comment {
  id              String    @id @default(cuid())
  postId          String
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId        String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentCommentId String?
  parent          Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")
  body            String    @db.VarChar(500)
  createdAt       DateTime  @default(now())

  @@index([postId, createdAt])
  @@index([parentCommentId])
}

enum LikeTarget {
  POST
  COMMENT
}

model Like {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType LikeTarget
  targetId   String
  createdAt  DateTime   @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Share {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  // For sharing user profiles, we just record the shared userId in `targetUserId`.
  targetUserId String?
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([targetUserId])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  members  ConversationMember[]
  messages Message[]
  reports  UserReport[]
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  pushMuted      Boolean      @default(false)
  wallpaper      String       @default("aurora")
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String       @default("") @db.VarChar(500)
  audioUrl       String?
  replyToId      String?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  forwardedFromMessageId String?
  forwardedFromMessage   Message?  @relation("ForwardedMessages", fields: [forwardedFromMessageId], references: [id], onDelete: SetNull)
  forwardedMessages      Message[] @relation("ForwardedMessages")
  createdAt      DateTime     @default(now())
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
  @@index([forwardedFromMessageId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

enum NotificationType {
  LIKE
  COMMENT
  REPLY
  MENTION
  MESSAGE
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type        NotificationType
  targetType  String?
  targetId    String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model UserBlock {
  id            String   @id @default(cuid())
  blockerId     String
  blocker       User     @relation("UserBlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("UserBlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
}

model UserReport {
  id             String        @id @default(cuid())
  reporterId     String
  reporter       User          @relation("UserReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String
  reportedUser   User          @relation("UserReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reason         String        @db.VarChar(80)
  details        String?       @db.VarChar(500)
  createdAt      DateTime      @default(now())

  @@index([reporterId, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([conversationId])
}
