# Only needed if you run the frontend on your HOST (npm run dev) rather than
# in Docker. If you use `docker compose up`, the root .env is enough — delete
# or ignore this file.
#
# Copy to .env.local and fill in. Same values as the root .env.

NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=<same as root .env>

# IMPORTANT: when running on the host, the backend is on localhost, not "backend"
BACKEND_URL=http://localhost:4000
PUBLIC_BACKEND_URL=http://localhost:4000

GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>

INTERNAL_API_TOKEN=<same as root .env>

# Google Analytics
NEXT_PUBLIC_GTAG_ID=G-45TBY74P9E
